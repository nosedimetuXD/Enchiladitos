# Puerto del servidor (opcional, en Render se asigna automáticamente)
PORT=8080

# URL de conexión a PostgreSQL / Supabase
# Ejemplo Supabase:
DB_URL=postgresql://postgres.xxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Secreto para firmar tokens JWT.
# En producción usa un valor largo y aleatorio (p. ej. `openssl rand -base64 48`), nunca
# el valor de ejemplo de abajo — este mismo texto aparece en el repositorio público.
JWT_SECRET=tu_secreto_super_seguro_aqui_12345

# Orígenes permitidos por CORS, separados por comas (sin espacios). Sin esta variable, la
# API cae a un origen de desarrollo local y NO permite "*" — configúrala en cada entorno
# con la(s) URL(s) reales del frontend.
# Ejemplo: ALLOWED_ORIGINS=https://enchiladitos-test.vercel.app,https://enchiladitos.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
